# ATLAS backend configuration.
# Copy this file to .env and adjust the values. Never commit .env.
# Every variable is optional: the defaults below run fully locally with Ollama.

# --- Text generation ---------------------------------------------------------
# "ollama" (local) or "openai_compatible" (any OpenAI-style API, e.g. Groq).
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://127.0.0.1:11434
# Required only for openai_compatible providers.
LLM_API_KEY=
# Context window used by Ollama (ignored by other providers).
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=120

# --- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=

# --- Example: online demo with Groq (uncomment and fill in) -----------------
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=<model name from the Groq console>
# LLM_API_KEY=<your Groq API key>