# ATLAS backend configuration.
# Copy this file to .env and adjust the values. Never commit .env.
# Every variable is optional: the defaults below run fully locally with Ollama.

# --- Text generation ---------------------------------------------------------
# "ollama" (local) or "openai_compatible" (any OpenAI-style API, e.g. Groq).
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://127.0.0.1:11434
# Required only for openai_compatible providers.
LLM_API_KEY=
# Context window used by Ollama (ignored by other providers).
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=120

# --- Embeddings --------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=

# --- Storage -----------------------------------------------------------------
# Folder for the SQLite database and uploaded files (ignored by Git).
DATA_DIR=data

# --- OCR (Tesseract) ---------------------------------------------------------
# Language pack used for scanned pages and images (must be installed).
OCR_LANGUAGE=eng
# Maximum time spent on one page before giving up.
OCR_TIMEOUT_SECONDS=60

# --- Upload limits -----------------------------------------------------------
MAX_UPLOAD_MB=20
# Pages (or slides, or DOCX sections) per document.
MAX_PAGES=50
# Scanned pages per document: OCR takes a few seconds per page.
MAX_OCR_PAGES=10

# --- Example: online demo with Groq (uncomment and fill in) -----------------
# Groq offers no embeddings: keep an embedding provider configured separately.
# Model list: https://console.groq.com/docs/models (it changes often).
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=<your Groq API key>